{
  "name": "wsterm",
  "version": "2.0.0-alpha.1",
  "description": "WSTerm - WebSocket Terminal for remote debugging of ESP32/ESP8266 Arduino devices",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.{ts,css,html}",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "arduino",
    "esp32",
    "esp8266",
    "debug",
    "remote",
    "websocket",
    "serial-monitor"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/karol-brejna-i/RemoteDebugApp"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {}
}
